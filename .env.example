# Адрес и ключ ТВОЕГО собственного Supabase на российском сервере (Timeweb Cloud).
# Как их получить — см. docs/RUSSIAN-HOSTING-SETUP.md.
#
# Скопируй этот файл в «.env» (без .example) и подставь свои значения.
# VITE_SUPABASE_URL     — адрес твоего сервера, напр. https://supabase.tvoi-domen.ru
#                         или http://IP-адрес:8000, если без домена.
# VITE_SUPABASE_ANON_KEY — публичный ключ «anon» из настроек проекта Supabase Studio
#                          (Settings → API → Project API keys → anon/public).

VITE_SUPABASE_URL=https://supabase.example.ru
VITE_SUPABASE_ANON_KEY=your-anon-key
